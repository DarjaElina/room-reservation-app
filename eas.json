{
  "cli": {
    "version": ">= 14.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true
    },
    "development-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL_STAGING": "https://backend-rough-wildflower-6075.fly.dev"
      }
    },
    "development-device": {
    "distribution": "internal",
    "android": {
      "buildType": "apk"
    },
    "env": {
      "EXPO_PUBLIC_BACKEND_URL_STAGING": "https://backend-rough-wildflower-6075.fly.dev"
    }
  }
  },
  "submit": {
    "production": {}
  }
}
