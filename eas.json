{
  "cli": {
    "version": ">= 14.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true
    },
    "e2e-test": {
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      }
    },
    "development-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://backend-rough-wildflower-6075.fly.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
